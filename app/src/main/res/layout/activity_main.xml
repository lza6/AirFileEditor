<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary_color"
                app:title="@string/app_name"
                app:titleTextColor="@color/white"
                app:menu="@menu/main_menu" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 权限状态卡片 (Compose) -->
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_view_permission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- 系统状态看板卡片 (Compose) -->
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_view_dashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- 主包区域卡片 (Compose) -->
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_view_main_pack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- 更新主包区域卡片 (Compose) -->
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_view_update_pack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- 实时日志卡片 (Compose) -->
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_view_log_console"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- V11.0.0 MVI 任务进度层 (Compose Overlay) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view_task_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
